{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tranuga",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-12",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "observability": { "enabled": true }
}
