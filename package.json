{
  "name": "tranuga",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Live bus routes and estimated transit journeys for UGA and InfoPoint networks",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:edge": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build": "tsc --noEmit && vite build",
    "check": "npm run test && npm run build && npm run test:e2e",
    "preview": "vite preview --host 0.0.0.0",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": { "leaflet": "1.9.4" },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/leaflet": "1.9.21",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "wrangler": "4.161.0"
  }
}
